generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Music {
  id          String      @id @default(uuid())
  title       String
  author      String
  releaseDate Int
  description String
  duration    Int // duration in seconds
  album       String?
  imgUrl      String
  genre       MusicGenres
  linkToYm    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Image {
  id        String   @id @default(uuid())
  url       String
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MusicGenres {
  ROCK
  HIP_HOP
  POP
  ELECTRONIC
  COUNTRY
  RAP
  JAZZ
  CLASSICAL
  ALTERNATIVE
  TECHNO
  METAL
  K_POP
  FOLK
  RIFF
  DECO
  SOUL
  BASS
  INDIE_ROCK
  ALT_METAL
}
